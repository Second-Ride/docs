{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docs-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  // Gleiche Adresse wie die Doku, damit der Browser keine fremde Herkunft sieht.
  // Voraussetzung: second-ride.de liegt im selben Cloudflare-Konto.
  "routes": [{ "pattern": "docs.second-ride.de/api/feedback", "zone_name": "second-ride.de" }],
  "observability": { "enabled": true },
  "vars": {
    "GITHUB_REPO": "Second-Ride/docs",
    "LABEL": "doku-feedback",
    "SITE_URL": "https://docs.second-ride.de/",
    "ALLOWED_ORIGINS": "https://docs.second-ride.de"
  },
  // Gegen Missbrauch: je Absender 3 Rückmeldungen pro Minute, insgesamt 20.
  // Die Zähler gelten je Rechenzentrum, das reicht als Bremse.
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "GLOBAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ]
  // Secret GITHUB_TOKEN: nicht hier eintragen, sondern `npx wrangler secret put GITHUB_TOKEN`
}
